# ==============================================================================
# ComicCraft Environment Configuration
# Copy this file to .env and insert your real API credentials.
# DO NOT commit .env containing real secrets to version control.
# ==============================================================================

# 1. API Credentials
# Get your Google Gemini API key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Get your Hugging Face inference token: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# 2. Gemini Model Configuration
# Configurable model IDs. Defaults use fast, cost-efficient, and current endpoints.
# The app includes automatic fallback across active Flash models (gemini-flash-lite-latest, gemini-3.8-flash, etc.).
GEMINI_OUTLINE_MODEL=gemini-flash-lite-latest
GEMINI_STORY_MODEL=gemini-flash-lite-latest

# 3. Hugging Face Text-to-Image Configuration
# Hosted provider and model name. If HF is unreachable or unconfigured, the app falls back cleanly.
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers
HF_PROVIDER=hf-inference

# 4. Image Generation Dimensions & Settings
IMAGE_WIDTH=768
IMAGE_HEIGHT=1024
IMAGE_STEPS=28
